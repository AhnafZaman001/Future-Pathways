# Copy this file to .env and fill in real values.
# Get these from the Supabase project dashboard (Project Settings > API).
# NEVER commit .env — it is already in .gitignore.

SUPABASE_URL=
# Anon (public) key — used to verify incoming user access tokens.
SUPABASE_ANON_KEY=
# Service role key — ONLY needed once the backend does privileged
# server-side work (e.g. admin data management). Not used by the
# foundation milestone. Keep out of source control at all times.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
